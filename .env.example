# Example configuration for the V2 application (npm start -> src/index.mjs).
# Copy to .env only in an authorized runtime checkout; never commit actual values.
# V3 pinned Telegram pilot uses separately provisioned private configuration files.

# Required: Telegram token from BotFather. Treat as a secret.
TELEGRAM_BOT_TOKEN=
# Required: numeric Telegram user ID allowed to access the V2 bot.
TELEGRAM_ALLOWED_USER_ID=

# Required by V2 configuration: Gemini API key. Prefer an authorized free tier.
GEMINI_API_KEY=
# Optional: OpenRouter key for fallback to the configured :free model.
# Leave empty to disable this provider; do not enable paid API usage.
OPENROUTER_API_KEY=

# Required: address of the existing authorized Home Assistant MCP endpoint.
# Keep the MCP endpoint on a trusted network; never expose it publicly.
MCP_URL=

# Optional: local HTTP API port, default 3000.
HTTP_PORT=3000
