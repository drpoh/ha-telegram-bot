{
  "name": "ha-telegram-bot",
  "version": "1.0.0",
  "description": "AI-powered Telegram assistant for Home Assistant via MCP",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "check": "find src test -name \"*.mjs\" -type f -exec node --check {} \\;",
    "test": "npm run check && node --test test/*.test.mjs"
  },
  "keywords": [
    "home-assistant",
    "telegram",
    "mcp",
    "ai",
    "gemini",
    "openrouter"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "telegraf": "^4.16.3"
  }
}
